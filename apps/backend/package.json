{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts 2>nul",
    "dev:verbose": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "check-types": "tsc --noEmit",
    "test:phase4": "tsx src/test-phase4.ts",
    "test:phase4:save": "tsx src/test-phase4-with-output.ts",
    "test:api": "tsx src/test-api.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@hono/node-server": "^1.13.7",
    "@huggingface/inference": "^4.13.9",
    "ai": "^4.0.58",
    "compute-cosine-similarity": "^1.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.7.11",
    "hono-rate-limiter": "^0.5.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.19.7",
    "@vitest/ui": "^4.0.17",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.17"
  }
}